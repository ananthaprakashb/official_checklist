{
  "name": "official-checklist",
  "version": "0.4.0",
  "private": true,
  "description": "Machine-verifiable OKF checklists and interactive preflight for official government and consular processes.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:okf": "tsx scripts/validate-okf.ts",
    "validate:data": "tsx scripts/validate-questionnaires.ts",
    "sources:check": "tsx scripts/check-source-freshness.ts",
    "sources:accept": "tsx scripts/accept-source-change.ts",
    "test:sources": "tsx scripts/test-source-freshness.ts",
    "test:source-monitor-exec": "tsx scripts/check-source-freshness.ts --offline",
    "test:official-links": "tsx scripts/test-official-links.ts",
    "test:question-conditions": "tsx scripts/test-questionnaire-conditions.ts",
    "test:high-friction": "tsx scripts/test-high-friction.ts",
    "test:california-dmv": "tsx scripts/test-california-dmv.ts",
    "test:evaluator": "tsx scripts/test-evaluator.ts",
    "test:i140": "tsx scripts/test-i140.ts",
    "test:i485": "tsx scripts/test-i485.ts",
    "test:nvc": "tsx scripts/test-nvc.ts",
    "test:engine": "tsx scripts/test-process-engine.ts",
    "validate": "npm run validate:okf && npm run validate:data && npm run test:sources && npm run test:source-monitor-exec && npm run test:official-links && npm run test:question-conditions && npm run test:high-friction && npm run test:california-dmv && npm run test:evaluator && npm run test:i140 && npm run test:i485 && npm run test:nvc && npm run test:engine && npm run typecheck",
    "test": "npm run validate",
    "deploy:cloudflare": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  }
}
