{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "us-employment-green-card-result.schema.json",
  "title": "U.S. Employment-Based Green Card Preflight Result",
  "type": "object",
  "required": [
    "status",
    "category",
    "stage",
    "petition_form",
    "labor_certification_route",
    "bulletin_month",
    "required_items",
    "conditional_items",
    "blockers",
    "warnings",
    "next_step",
    "sources_verified"
  ],
  "properties": {
    "status": { "enum": ["READY", "NOT_READY", "NEEDS_AUTHORITATIVE_CONFIRMATION"] },
    "category": { "type": "string" },
    "stage": { "type": "string" },
    "petition_form": { "type": "string" },
    "labor_certification_route": { "type": "string" },
    "priority_date": { "type": ["string", "null"] },
    "bulletin_month": { "type": "string" },
    "dates_for_filing_cutoff": { "type": ["string", "null"] },
    "dates_for_filing_eligible": { "type": ["boolean", "null"] },
    "final_action_cutoff": { "type": ["string", "null"] },
    "final_action_eligible": { "type": ["boolean", "null"] },
    "required_items": { "type": "array", "items": { "type": "string" } },
    "conditional_items": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "next_step": { "type": "string" },
    "sources_verified": { "type": "string" }
  },
  "additionalProperties": true
}
