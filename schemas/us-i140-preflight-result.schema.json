{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://official-checklist.local/schemas/us-i140-preflight-result.schema.json",
  "title": "U.S. I-140 Preflight Result",
  "type": "object",
  "required": ["status", "category", "classification_code", "petitioner_route", "labor_route", "priority_date_basis", "premium_processing_window", "required_items", "conditional_items", "blockers", "warnings", "next_step", "sources_verified"],
  "properties": {
    "status": { "enum": ["READY", "NOT_READY", "NEEDS_AUTHORITATIVE_CONFIRMATION"] },
    "category": { "type": "string" },
    "classification_code": { "type": "string" },
    "petitioner_route": { "type": "string" },
    "labor_route": { "type": "string" },
    "priority_date_basis": { "type": "string" },
    "premium_processing_window": { "type": "string" },
    "required_items": { "type": "array", "items": { "type": "string" } },
    "conditional_items": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "next_step": { "type": "string" },
    "sources_verified": { "type": "string" }
  },
  "additionalProperties": false
}
