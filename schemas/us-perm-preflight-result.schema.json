{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "us-perm-preflight-result.schema.json",
  "title": "U.S. PERM Detailed Preflight Result",
  "type": "object",
  "required": [
    "status",
    "stage",
    "occupation_route",
    "pwd_status",
    "priority_date",
    "required_items",
    "conditional_items",
    "blockers",
    "warnings",
    "next_step",
    "sources_verified"
  ],
  "properties": {
    "status": { "enum": ["READY", "NOT_READY", "NEEDS_AUTHORITATIVE_CONFIRMATION"] },
    "stage": { "type": "string" },
    "occupation_route": { "type": "string" },
    "pwd_status": { "type": "string" },
    "priority_date": { "type": ["string", "null"] },
    "eta9089_filing_date": { "type": ["string", "null"] },
    "pwd_window_status": { "type": "string" },
    "recruitment_window_status": { "type": "string" },
    "notice_window_status": { "type": "string" },
    "audit_status": { "type": "string" },
    "determination_status": { "type": "string" },
    "required_items": { "type": "array", "items": { "type": "string" } },
    "conditional_items": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "next_step": { "type": "string" },
    "sources_verified": { "type": "string" }
  },
  "additionalProperties": true
}
