{
  "id": "usa-employment-green-card-preflight-v1",
  "version": 1,
  "verified": "2026-08-30",
  "stale_after": "2026-09-13",
  "questions": [
    {
      "id": "employment_category",
      "type": "select",
      "required": true,
      "options": [
        "eb1a_extraordinary_ability",
        "eb1b_outstanding_professor_researcher",
        "eb1c_multinational_manager_executive",
        "eb2_advanced_degree_exceptional_ability",
        "eb2_national_interest_waiver",
        "eb3_professional",
        "eb3_skilled_worker",
        "eb3_other_worker",
        "schedule_a",
        "eb4_special_immigrant",
        "eb5_unreserved",
        "eb5_rural_set_aside",
        "eb5_high_unemployment_set_aside",
        "eb5_infrastructure_set_aside",
        "not_sure"
      ]
    },
    {
      "id": "schedule_a_preference",
      "type": "select",
      "required_when": { "employment_category": "schedule_a" },
      "options": ["eb2", "eb3", "not_sure"]
    },
    {
      "id": "employment_gc_stage",
      "type": "select",
      "required": true,
      "options": [
        "planning",
        "labor_certification",
        "immigrant_petition",
        "waiting_for_visa_number",
        "adjustment_of_status",
        "consular_processing",
        "pending_adjustment",
        "not_sure"
      ]
    },
    {
      "id": "beneficiary_location",
      "type": "select",
      "required": true,
      "options": ["inside_us", "outside_us", "not_sure"]
    },
    {
      "id": "labor_certification_route",
      "type": "select",
      "required": true,
      "options": ["dol_perm", "schedule_a", "not_required", "not_sure"]
    },
    {
      "id": "perm_status",
      "type": "select",
      "required_when": { "labor_certification_route": "dol_perm" },
      "options": ["not_started", "prevailing_wage", "recruitment", "filed", "certified", "denied", "expired", "not_sure"]
    },
    {
      "id": "perm_certification_within_180_days",
      "type": "boolean",
      "required_when": { "perm_status": "certified" }
    },
    {
      "id": "immigrant_petition_status",
      "type": "select",
      "required": true,
      "options": ["not_filed", "pending", "approved", "denied", "not_sure"]
    },
    {
      "id": "priority_date_known",
      "type": "boolean",
      "required": true
    },
    {
      "id": "priority_date",
      "type": "string",
      "required_when": { "priority_date_known": true }
    },
    {
      "id": "chargeability_country",
      "type": "select",
      "required": true,
      "options": ["india", "china_mainland", "mexico", "philippines", "all_other", "not_sure"]
    },
    {
      "id": "bulletin_month",
      "type": "select",
      "required": true,
      "options": ["august_2026", "september_2026", "later_or_not_sure"]
    },
    {
      "id": "intended_final_processing",
      "type": "select",
      "required": true,
      "options": ["adjustment_in_us", "consular_abroad", "not_sure"]
    },
    {
      "id": "physically_present_in_us",
      "type": "boolean",
      "required_when": { "intended_final_processing": "adjustment_in_us" }
    },
    {
      "id": "uscis_chart_selection",
      "type": "select",
      "required_when": { "intended_final_processing": "adjustment_in_us" },
      "options": ["final_action", "dates_for_filing", "not_checked"]
    },
    {
      "id": "employment_basis_still_valid",
      "type": "boolean",
      "required_when": { "intended_final_processing": "adjustment_in_us" }
    },
    {
      "id": "medical_i693_ready",
      "type": "boolean",
      "required_when": { "intended_final_processing": "adjustment_in_us" }
    },
    {
      "id": "complex_adjustment_issue",
      "type": "boolean",
      "required_when": { "intended_final_processing": "adjustment_in_us" }
    },
    {
      "id": "i485_status",
      "type": "select",
      "required_when": { "intended_final_processing": "adjustment_in_us" },
      "options": ["not_filed", "pending", "approved", "denied", "not_sure"]
    },
    {
      "id": "nvc_case_created",
      "type": "boolean",
      "required_when": { "intended_final_processing": "consular_abroad" }
    },
    {
      "id": "include_derivatives",
      "type": "boolean",
      "required": true
    },
    {
      "id": "i485_pending_180_days",
      "type": "boolean",
      "required_when": { "employment_gc_stage": "pending_adjustment" }
    },
    {
      "id": "job_changed_or_portability_needed",
      "type": "boolean",
      "required_when": { "employment_gc_stage": "pending_adjustment" }
    },
    {
      "id": "request_ead_with_i485",
      "type": "boolean",
      "required_when": { "intended_final_processing": "adjustment_in_us" }
    },
    {
      "id": "request_advance_parole_with_i485",
      "type": "boolean",
      "required_when": { "intended_final_processing": "adjustment_in_us" }
    }
  ],
  "rule_nodes": [
    "okf/decisions/usa-employment-green-card-category.md",
    "okf/processes/usa/immigration/employment-green-card.md",
    "okf/requirements/usa-employment-green-card-perm.md",
    "okf/requirements/usa-employment-green-card-petition.md",
    "okf/requirements/usa-employment-green-card-adjustment-consular.md"
  ],
  "result_schema": "schemas/us-employment-green-card-result.schema.json"
}
